rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---- HELPER FUNCTIONS ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'maryke@travellingsouthafrica.co.za',
        'tristan@industrialgrowthhub.com'
      ];
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // ---- SUBMISSION IMAGES (signed-in users upload, admins manage) ----
    // Matches: /submissions/accommodations/{docId}/filename.jpg
    match /submissions/{listingType}/{docId}/{fileName} {
      allow read: if true;                          // Public can view approved images
      allow create: if isSignedIn() && isValidImage(); // Signed-in users upload
      allow delete: if isAdmin();                   // Only admins can delete
      allow update: if false;                       // No overwrites - delete & re-upload
    }

    // ---- ADMIN-MANAGED LISTING IMAGES (approved/published listings) ----
    // Matches: /listings/accommodations/{docId}/filename.jpg
    match /listings/{listingType}/{docId}/{fileName} {
      allow read: if true;       // Public can read
      allow write: if isAdmin(); // Only admins can write
    }

    // ---- PROVINCE / TOWN / SIGHT IMAGES (admin only) ----
    match /provinces/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /towns/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sights/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routes/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- DENY EVERYTHING ELSE ----
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}