/**
 * This ruleset defines the security model for the "Travelling South Africa" application.
 * It segregates access between public content, private user data, and admin-managed listings.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == 'maryke@travellingsouthafrica.co.za' || 
              request.auth.token.email == 'tristan@industrialgrowthhub.com');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isListingOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function createsValidUserData(userId) {
      return request.resource.data.id == userId;
    }

    function updatesValidUserData() {
      return request.resource.data.id == resource.data.id;
    }

    function createsValidUserSubcollectionData(userId) {
      return request.resource.data.userId == userId;
    }

    function updatesValidUserSubcollectionData() {
      return request.resource.data.userId == resource.data.userId;
    }
    
    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && createsValidUserData(userId);
      allow update: if isOwner(userId) && updatesValidUserData();
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Public & Listing Content Rules
    // -------------------------------------------------------------------------

    // Rules for static content like provinces, towns, sights, routes
    match /{publicCollection}/{docId}
      where publicCollection in ['provinces', 'towns', 'sights', 'routes'] {
      
      // Anyone can read this data
      allow get, list: if true;
      
      // Only admins can write to this data
      allow write: if isAdmin();
    }
    
    // --- ACCOMMODATIONS ---
    match /accommodations/{listingId} {
      allow get: if isAdmin() || (resource.data.approved == true);
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.approved == true && request.resource.data.ownerUid == request.auth.uid;
      allow create: if !isAdmin() && request.resource.data.approved == false && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (isListingOwner() && resource.data.approved == false);
      allow delete: if isAdmin() || (isListingOwner() && resource.data.approved == false);
    }

    // --- RESTAURANTS ---
    match /restaurants/{listingId} {
      allow get: if isAdmin() || (resource.data.approved == true);
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.approved == true && request.resource.data.ownerUid == request.auth.uid;
      allow create: if !isAdmin() && request.resource.data.approved == false && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (isListingOwner() && resource.data.approved == false);
      allow delete: if isAdmin() || (isListingOwner() && resource.data.approved == false);
    }
    
    // --- SERVICE PROVIDERS ---
    match /service_providers/{listingId} {
      allow get: if isAdmin() || (resource.data.approved == true);
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.approved == true && request.resource.data.ownerUid == request.auth.uid;
      allow create: if !isAdmin() && request.resource.data.approved == false && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (isListingOwner() && resource.data.approved == false);
      allow delete: if isAdmin() || (isListingOwner() && resource.data.approved == false);
    }

    // --- ATTRACTIONS ---
    match /attractions/{listingId} {
      allow get: if isAdmin() || (resource.data.approved == true);
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.approved == true && request.resource.data.ownerUid == request.auth.uid;
      allow create: if !isAdmin() && request.resource.data.approved == false && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (isListingOwner() && resource.data.approved == false);
      allow delete: if isAdmin() || (isListingOwner() && resource.data.approved == false);
    }
  }
}
