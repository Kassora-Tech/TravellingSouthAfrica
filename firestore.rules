/**
 * This ruleset defines the security model for the "Travelling South Africa" application.
 * It segregates access between public content, private user data, and admin-managed listings.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'maryke@travellingsouthafrica.co.za',
        'tristan@industrialgrowthhub.com'
      ];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isListingOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function createsValidUserData(userId) {
      return request.resource.data.id == userId;
    }

    function updatesValidUserData() {
      return request.resource.data.id == resource.data.id;
    }

    function createsValidUserSubcollectionData(userId) {
      return request.resource.data.userId == userId;
    }

    function updatesValidUserSubcollectionData() {
      return request.resource.data.userId == resource.data.userId;
    }

    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && createsValidUserData(userId);
      allow update: if isOwner(userId) && updatesValidUserData();
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Public & Listing Content Rules
    // -------------------------------------------------------------------------

    // Rules for static content like provinces, towns, sights, routes
    match /{publicCollection}/{docId}
      where publicCollection in ['provinces', 'towns', 'sights', 'routes'] {
      
      // Anyone can read this data
      allow get, list: if true;
      
      // Only admins can write to this data
      allow write: if isAdmin();
    }
    
    // Rules for user-submitted listings
    match /{listingCollection}/{listingId}
      where listingCollection in ['accommodations', 'restaurants', 'service_providers', 'attractions'] {
        
      // Admins can read and write everything.
      allow read, write: if isAdmin();
      
      // Public users can get a single document if it's approved.
      allow get: if resource.data.approved == true;
      
      // Public users can list documents only if they query for approved documents.
      allow list: if request.query.where.approved == true;
      
      // A signed-in user can CREATE a NEW listing.
      allow create: if isSignedIn() 
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.approved == false;
                    
      // The owner of a PENDING listing can UPDATE or DELETE it.
      allow update, delete: if isListingOwner() && resource.data.approved == false;
    }
  }
}
