/**
 * This ruleset defines the security model for the "Travelling South Africa" application.
 * It segregates access between public content, private user data, and admin-managed listings.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == 'maryke@travellingsouthafrica.co.za' || 
              request.auth.token.email == 'tristan@industrialgrowthhub.com');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Public & Listing Content Rules
    // -------------------------------------------------------------------------

    // Rules for static content like provinces, towns, sights, routes
    match /{publicCollection}/{docId}
      where publicCollection in ['provinces', 'towns', 'sights', 'routes'] {
      
      // Anyone can read this data
      allow get, list: if true;
      
      // Only admins can write to this data
      allow write: if isAdmin();
    }
    
    // --- LISTINGS (Accommodations, Restaurants, Service Providers, Attractions) ---
    match /{collection}/{listingId}
      where collection in ['accommodations', 'restaurants', 'service_providers', 'attractions'] {

        function isListingOwner() {
          return isSignedIn() && resource.data.ownerUid == request.auth.uid;
        }

        // Public can get approved listings. Admins can get any.
        allow get: if isAdmin() || (resource.data.approved == true);

        // Only admins can list documents.
        allow list: if isAdmin();

        // Allow create for signed-in owners.
        // Admins can set approved:true, others must set approved:false.
        allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid
          && (request.resource.data.approved == false || isAdmin());

        // Only admins can update or delete.
        allow update, delete: if isAdmin();
    }
  }
}
