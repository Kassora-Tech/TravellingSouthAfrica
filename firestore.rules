rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.email == 'maryke@travellingsouthafrica.co.za' || request.auth.token.email == 'tristan@industrialgrowthhub.com';
    }
    
    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Public & Listing Content Rules
    // -------------------------------------------------------------------------

    // Rules for static content like provinces, towns, sights, routes
    match /{publicCollection}/{docId}
      where publicCollection in ['provinces', 'towns', 'sights', 'routes'] {
      
      // Anyone can read this data
      allow get, list: if true;
      
      // Only admins can write to this data
      allow write: if isAdmin();
    }
    
    // --- Listing Type Rules (Separated for clarity) ---

    match /accommodations/{listingId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow list: if isAdmin();

      // Admins can create pre-approved listings
      allow create: if isAdmin() &&
                       request.resource.data.approved == true &&
                       request.resource.data.ownerUid == request.auth.uid;
                       
      // Regular users can create listings that are pending approval
      allow create: if !isAdmin() &&
                       request.auth != null &&
                       request.resource.data.approved == false &&
                       request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if isAdmin();
    }
    
    match /restaurants/{listingId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow list: if isAdmin();

      // Admins can create pre-approved listings
      allow create: if isAdmin() &&
                       request.resource.data.approved == true &&
                       request.resource.data.ownerUid == request.auth.uid;
                       
      // Regular users can create listings that are pending approval
      allow create: if !isAdmin() &&
                       request.auth != null &&
                       request.resource.data.approved == false &&
                       request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if isAdmin();
    }
    
    match /service_providers/{listingId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow list: if isAdmin();

      // Admins can create pre-approved listings
      allow create: if isAdmin() &&
                       request.resource.data.approved == true &&
                       request.resource.data.ownerUid == request.auth.uid;
                       
      // Regular users can create listings that are pending approval
      allow create: if !isAdmin() &&
                       request.auth != null &&
                       request.resource.data.approved == false &&
                       request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if isAdmin();
    }
    
    match /attractions/{listingId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow list: if isAdmin();

      // Admins can create pre-approved listings
      allow create: if isAdmin() &&
                       request.resource.data.approved == true &&
                       request.resource.data.ownerUid == request.auth.uid;
                       
      // Regular users can create listings that are pending approval
      allow create: if !isAdmin() &&
                       request.auth != null &&
                       request.resource.data.approved == false &&
                       request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if isAdmin();
    }
  }
}
