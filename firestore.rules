rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.email in ['maryke@travellingsouthafrica.co.za', 'tristan@industrialgrowthhub.com'];
    }

    function canCreateListing() {
      return request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }
    
    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Public & Listing Content Rules
    // -------------------------------------------------------------------------

    match /{publicCollection}/{docId}
      where publicCollection in ['provinces', 'towns', 'sights', 'routes', 'routeHighlightLinks'] {
      
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /accommodations/{listingId} {
      allow read: if true;
      allow create: if canCreateListing();
      allow update, delete: if isAdmin();
    }

    match /restaurants/{listingId} {
      allow read: if true;
      allow create: if canCreateListing();
      allow update, delete: if isAdmin();
    }

    match /service_providers/{listingId} {
      allow read: if true;
      allow create: if canCreateListing();
      allow update, delete: if isAdmin();
    }

    match /attractions/{listingId} {
      allow read: if true;
      allow create: if canCreateListing();
      allow update, delete: if isAdmin();
    }
    
    // --- Contact Form Submissions ---
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
