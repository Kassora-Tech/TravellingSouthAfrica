/**
 * This ruleset defines the security model for the "Travelling South Africa" application.
 * It segregates access between public content, private user data, and admin-managed listings.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['maryke@travellingsouthafrica.co.za', 'tristan@industrialgrowthhub.com'];
    }
    
    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Public & Listing Content Rules
    // -------------------------------------------------------------------------

    // Rules for static content like provinces, towns, sights, routes
    match /{publicCollection}/{docId}
      where publicCollection in ['provinces', 'towns', 'sights', 'routes'] {
      
      // Anyone can read this data
      allow get, list: if true;
      
      // Only admins can write to this data
      allow write: if isAdmin();
    }
    
    // --- LISTINGS (Accommodations, Restaurants, Service Providers, Attractions) ---
    match /{collection}/{listingId}
      where collection in ['accommodations', 'restaurants', 'service_providers', 'attractions'] {
      
      allow read: if resource.data.approved == true || isAdmin();
      
      allow list: if isAdmin();

      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid &&
          ( (isAdmin() && request.resource.data.approved == true) ||
            (!isAdmin() && request.resource.data.approved == false) );

      allow update, delete: if isAdmin();
    }
  }
}
