rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.email in ['maryke@travellingsouthafrica.co.za', 'tristan@industrialgrowthhub.com'];
    }
    
    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Public & Listing Content Rules
    // -------------------------------------------------------------------------

    // Rules for static content like provinces, towns, sights, routes
    match /{publicCollection}/{docId}
      where publicCollection in ['provinces', 'towns', 'sights', 'routes'] {
      
      // Anyone can read this data
      allow get, list: if true;
      
      // Only admins can write to this data
      allow write: if isAdmin();
    }
    
    // --- Combined Rule for ALL Listing Types ---
    match /{collection}/{listingId}
        where collection in ['accommodations', 'restaurants', 'service_providers', 'attractions'] {

      // Anyone can read approved listings, admins can read all
      allow read: if resource.data.approved == true || isAdmin();

      // Only admins can list entire collections (for the admin dashboard)
      allow list: if isAdmin();

      // Let authenticated users create their own listings.
      // Admins can bypass the 'approved == false' check.
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid &&
                    (request.resource.data.approved == false || isAdmin());

      // Only admins can update or delete listings
      allow update, delete: if isAdmin();
    }
  }
}
