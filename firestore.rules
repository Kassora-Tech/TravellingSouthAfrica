rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- HELPER FUNCTIONS ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['maryke@travellingsouthafrica.co.za', 'tristan@industrialgrowthhub.com'];
    }

    function canCreateListing() {
      return request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // ---- USERS ----
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // ---- PUBLIC CONTENT ----
    match /provinces/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /towns/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sights/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routeHighlightLinks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- LISTINGS ----
    match /accommodations/{docId} {
      allow read: if true;
      allow create: if canCreateListing();
      allow update, delete: if isAdmin();
    }

    match /restaurants/{docId} {
      allow read: if true;
      allow create: if canCreateListing();
      allow update, delete: if isAdmin();
    }

    match /service_providers/{docId} {
      allow read: if true;
      allow create: if canCreateListing();
      allow update, delete: if isAdmin();
    }

    match /attractions/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.token.email in [
          'maryke@travellingsouthafrica.co.za',
          'tristan@industrialgrowthhub.com'
        ];
    }

    // ---- CONTACTS ----
    match /contactMessages/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

  }
}
