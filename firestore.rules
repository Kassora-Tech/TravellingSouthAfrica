rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.email in ['maryke@travellingsouthafrica.co.za', 'tristan@industrialgrowthhub.com'];
    }
    
    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Public & Listing Content Rules
    // -------------------------------------------------------------------------

    // Rules for other static content
    match /{publicCollection}/{docId}
      where publicCollection in ['provinces', 'towns', 'sights', 'routes', 'routeHighlightLinks'] {
      
      // Anyone can read this data
      allow read: if true;
      
      // Only admins can write to this data
      allow write: if isAdmin();
    }
    
    // --- Combined Listing Type Rules ---
    match /{listingCollection}/{listingId}
      where listingCollection in ['accommodations', 'restaurants', 'service_providers', 'attractions'] {
      
      allow read: if true;
      
      // Admins must create approved listings; regular users must create unapproved listings.
      // Both must be the owner of the document they are creating.
      allow create: if request.auth != null && 
                       request.resource.data.ownerUid == request.auth.uid &&
                       (isAdmin() == request.resource.data.approved);

      allow update, delete: if isAdmin();
    }
  }
}
